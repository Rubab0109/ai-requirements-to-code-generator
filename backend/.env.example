# Backend settings
APP_NAME="AI Requirements-to-Code Generator"
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Choose one provider: gemini | groq | openai
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.2

# Keep TRUE for classroom demo without API key. Set FALSE when you want real API errors.
ALLOW_DEMO_FALLBACK=true

# Gemini default provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Groq provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# SQLite database path
SQLITE_DB_PATH=./data/projects.db
